# Propietario del repositorio: yersonct. Copiar como .env, completar localmente.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
DatabaseProvider=PostgreSQL
ConnectionStrings__PostgresConnection=Host=localhost;Port=5432;Database=saborexpress;Username=saborexpress;Password=REPLACE_LOCALLY
JwtSettings__SecretKey=
JwtSettings__Issuer=SaborExpress
JwtSettings__Audience=SaborExpressClients
JwtSettings__ExpirationInMinutes=30
JwtSettings__RefreshTokenExpirationHours=12
AllowedOrigins__0=http://localhost:3000
App__FrontendBaseUrl=http://localhost:3000
AppSettings__PublicBaseUrl=http://localhost:5000
Database__ApplyMigrationsOnStartup=false
Database__SeedOnStartup=false
Database__BackupConfirmed=false
InitialManager__Email=
InitialManager__Password=
InitialManager__FullName=yersonct
InitialManager__Document=
Brevo__ApiKey=
Wompi__PublicKey=
Wompi__PrivateKey=configure-this-in-your-secret-manager
Wompi__IntegritySecret=
Wompi__EventsSecret=
